# Copy to .env.drift-test.local (gitignored); use staging-only credentials.
# A distinct test domain avoids sharing production login cookies.
PUBLIC_SITE_URL=https://drift-test.example.net
CORS_ORIGINS=https://drift-test.example.net
# No parent-domain cookie for this isolated stack.
AUTH_COOKIE_DOMAIN=drift-test.example.net
TRUST_PROXY=true
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_USERNAME=drift-reviewer
ADMIN_PASSWORD=replace-with-a-staging-only-admin-password
ADMIN_EMAIL=reviewer@example.net
