[Unit]
Description=Check official chat completion without a user transaction
After=network-online.target tsu-api.service
[Service]
Type=oneshot
User=tsu-api
Group=tsu-api
WorkingDirectory=/opt/tsu-api/current
EnvironmentFile=/etc/tsu-api/tsu-api.env
ExecStart=/opt/tsu-api/runtime/bin/node /opt/yachiyo-status/llm.mjs
StateDirectory=yachiyo-status-llm
StateDirectoryMode=0755
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
TimeoutStartSec=50
