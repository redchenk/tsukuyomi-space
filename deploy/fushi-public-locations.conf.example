# 需批准后加入国内公开 OpenResty server block，与现有 origin 转发链一致。
# 保留 /.well-known/acme-challenge/ 和现有全局安全响应头。
location ~ ^/(?:\.well-known/(?:oauth-protected-resource(?:/api/fushi/mcp)?|oauth-authorization-server)|fushi/oauth/(?:token|revoke))$ {
    proxy_pass http://127.0.0.1:3280;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    proxy_read_timeout 15s;
    client_max_body_size 16k;
}
