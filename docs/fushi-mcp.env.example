# 示例，默认关闭。实际启用须先确认账号绑定、OAuth 客户端及秘密存储。
FUSHI_ENABLED=false
FUSHI_ORIGIN=https://yachiyo.hk
FUSHI_USER_ID=replace-with-fixed-assistant-account-id
# 推荐 CIMD：读取官方公开元数据，验证其中完整的 HTTPS redirect URI。
FUSHI_OAUTH_CLIENT_MODE=cimd
FUSHI_OAUTH_CLIENT_ID=https://chatgpt.com/oauth/client.json
# CIMD 模式不填写。只有切换为 predefined 时，才复制管理页的精确 URI。
# OAuth 回跳地址与 events/subscribe 提供的 webhook URL 是两回事。
FUSHI_OAUTH_REDIRECT_URI=
# 独立的 32 字节随机 AES-256-GCM 密钥，标准 base64 编码。
# 实际值只放在服务器受限环境文件/秘密管理器中，不能提交或回传聊天。
FUSHI_SECRET_KEY=

# 可选的 Fushi 专用海外出站通道，默认关闭。须另行批准专用 SSH 凭证。
# 沿用现有海外服务器 SSH 端口，不开启新的公网代理或共享 root 密钥。
FUSHI_EGRESS_MODE=direct
FUSHI_EGRESS_SSH_HOST=
FUSHI_EGRESS_SSH_PORT=47388
FUSHI_EGRESS_SSH_USER=fushi-egress
FUSHI_EGRESS_SSH_IDENTITY=/etc/tsukuyomi-fushi-egress-client/id_ed25519
FUSHI_EGRESS_SSH_KNOWN_HOSTS=/etc/tsukuyomi-fushi-egress-client/known_hosts
