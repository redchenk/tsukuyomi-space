# 示例，默认关闭。实际启用须先确认账号绑定、OAuth 客户端及秘密存储。
FUSHI_ENABLED=false
FUSHI_ORIGIN=https://yachiyo.hk
FUSHI_USER_ID=replace-with-fixed-assistant-account-id
# 预登记的 public OAuth client；与插件管理页面配置完全一致。
FUSHI_OAUTH_CLIENT_ID=replace-with-registered-public-client-id
# 从插件管理页面复制完整 OAuth redirect URI，禁止猜测或通配。
# 这是 OAuth 回跳地址，和 events/subscribe 提供的 webhook URL 是两回事。
FUSHI_OAUTH_REDIRECT_URI=
# 独立的 32 字节随机 AES-256-GCM 密钥，标准 base64 编码。
# 实际值只放在服务器受限环境文件/秘密管理器中，不能提交或回传聊天。
FUSHI_SECRET_KEY=
