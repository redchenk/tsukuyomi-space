NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=true
ENABLE_FRONTEND_DIST=true

# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=24h
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TIMEOUT_MS=1200
EMAIL_CODE_TTL_MS=600000
EMAIL_CODE_COOLDOWN_MS=60000
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_FAILURE_MAX=8
WEATHER_CACHE_SECONDS=600
REQUEST_BODY_LIMIT=200mb

DATA_DIR=/var/lib/tsukuyomi-space
DB_PATH=/var/lib/tsukuyomi-space/tsukuyomi.db
CORS_ORIGINS=https://your-domain.example
PUBLIC_SITE_URL=https://yachiyo.hk
OAUTH_REDIRECT_BASE=https://origin.yachiyo.hk
OAUTH_STATE_TTL_MS=600000
OAUTH_PENDING_TTL_MS=900000
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=
QQ_REDIRECT_URI=https://origin.yachiyo.hk/api/auth/oauth/qq/callback
# Optional OSS/CDN base for public static resources such as /assets, /models and /lib.
# Frontend builds use VITE_PUBLIC_ASSET_BASE_URL. Backend/SEO may use PUBLIC_ASSET_BASE_URL later.
PUBLIC_ASSET_BASE_URL=
VITE_PUBLIC_ASSET_BASE_URL=
SITE_LAUNCHED_AT=2026-03-30T00:00:00+08:00

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=change-this-admin-password

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=月读空间

LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=moonshot-v1-8k

# Room long-term memory vector store.
# Leave ROOM_MEMORY_VECTOR_BACKEND blank to use SQLite vector fallback only.
# Set ROOM_MEMORY_VECTOR_BACKEND=milvus and MILVUS_ADDRESS=127.0.0.1:19530 after Milvus is running.
ROOM_MEMORY_VECTOR_BACKEND=
MILVUS_ADDRESS=
MILVUS_TOKEN=
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=
ROOM_MEMORY_MILVUS_COLLECTION=tsukuyomi_room_memories
ROOM_MEMORY_VECTOR_DIM=96
ROOM_MEMORY_CONTENT_LIMIT=12000
ROOM_MEMORY_EMBEDDING_API_URL=
ROOM_MEMORY_EMBEDDING_API_KEY=
ROOM_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
ROOM_MEMORY_EMBEDDING_TIMEOUT_MS=10000
ROOM_MEMORY_MILVUS_RETRY_COOLDOWN_MS=30000
ROOM_MEMORY_MILVUS_CONSISTENCY=Strong
ROOM_ANTHROPIC_MAX_TOKENS=16384
ROOM_PERSONA_CORPUS_PATH=E:\visualstudio\yachiyo_novel_detailed_corpus.txt

TTS_PROVIDER=mimo
TTS_API_KEY=
TTS_API_URL=
TTS_MODEL=mimo-v2-tts
TTS_VOICE=mimo_default

# MiniMax cloned voice created from E:\visualstudio\minimax on 2026-05-25.
# To use it through the backend proxy, set:
# TTS_PROVIDER=minimax
# TTS_API_URL=https://api.minimaxi.com/v1/t2a_v2
# TTS_MODEL=speech-2.8-hd
# TTS_VOICE=yachiyo_jp_prompt_20260525c

# Optional GPT-SoVITS API. Only localhost /tts is allowed by /api/tts.
# Start GPT-SoVITS API first, for example:
# E:\visualstudio\tts\runtime\python.exe api_v2.py -a 127.0.0.1 -p 9880 -c GPT_SoVITS/configs/tts_infer.yaml
# Browser direct mode uses http://localhost:9880/tts in room TTS settings with "server proxy" disabled.
GPT_SOVITS_API_URL=http://127.0.0.1:9880/tts
GPT_SOVITS_REF_AUDIO_PATH=
GPT_SOVITS_PROMPT_TEXT=
GPT_SOVITS_TEXT_LANG=zh
GPT_SOVITS_PROMPT_LANG=zh
