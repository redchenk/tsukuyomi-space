NODE_ENV=production
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true
ENABLE_FRONTEND_DIST=true
TSUKUYOMI_HTTP_PORT=3280

# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=24h

# Leave empty to use the in-process fallback store.
# If you start the Compose Redis profile, set this to redis://redis:6379/0.
REDIS_URL=
REDIS_TIMEOUT_MS=1200
EMAIL_CODE_TTL_MS=600000
EMAIL_CODE_COOLDOWN_MS=60000
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_FAILURE_MAX=8
WEATHER_CACHE_SECONDS=600
REQUEST_BODY_LIMIT=200mb

DATA_DIR=/data
DB_PATH=/data/tsukuyomi.db
CORS_ORIGINS=http://localhost:3280
PUBLIC_SITE_URL=https://yachiyo.hk
PUBLIC_ASSET_BASE_URL=
VITE_PUBLIC_ASSET_BASE_URL=
SITE_LAUNCHED_AT=2026-03-30T00:00:00+08:00

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=月读空间

LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=moonshot-v1-8k

# SQLite vector search is the lightweight default and keeps memories account-isolated.
# Set COMPOSE_PROFILES=milvus and the two values below only on a host sized for Milvus.
COMPOSE_PROFILES=
ROOM_MEMORY_VECTOR_BACKEND=
MILVUS_ADDRESS=
MILVUS_MINIO_ACCESS_KEY=replace-with-a-random-access-key
MILVUS_MINIO_SECRET_KEY=replace-with-a-long-random-secret
MILVUS_TOKEN=
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=
ROOM_MEMORY_MILVUS_COLLECTION=tsukuyomi_room_memories
ROOM_MEMORY_VECTOR_DIM=96
ROOM_MEMORY_CONTENT_LIMIT=12000
ROOM_MEMORY_EMBEDDING_API_URL=
ROOM_MEMORY_EMBEDDING_API_KEY=
ROOM_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
ROOM_MEMORY_EMBEDDING_TIMEOUT_MS=10000
ROOM_MEMORY_MILVUS_RETRY_COOLDOWN_MS=30000
ROOM_MEMORY_MILVUS_CONSISTENCY=Strong
ROOM_ANTHROPIC_MAX_TOKENS=16384
ROOM_PERSONA_CORPUS_PATH=/data/yachiyo_novel_detailed_corpus.txt

TTS_PROVIDER=mimo
TTS_API_KEY=
TTS_API_URL=
TTS_MODEL=mimo-v2-tts
TTS_VOICE=mimo_default

# MiniMax cloned voice created from E:\visualstudio\minimax on 2026-05-25.
# To use it through the backend proxy, set:
# TTS_PROVIDER=minimax
# TTS_API_URL=https://api.minimaxi.com/v1/t2a_v2
# TTS_MODEL=speech-2.8-hd
# TTS_VOICE=yachiyo_jp_prompt_20260525c
